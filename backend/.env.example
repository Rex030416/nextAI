# Copy this file to backend/.env. Spring Boot loads it locally and it must not be committed.
NEXTAI_JDBC_DATABASE_URL=jdbc:postgresql://localhost:5433/nextai
NEXTAI_DB_USER=nextai
NEXTAI_DB_PASSWORD=change-me-for-production
OPENAI_API_KEY=replace-with-your-key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# The Java backend runs on the host. If it later runs inside Docker, use http://minio:9000 instead.
NEXTAI_MINIO_ENDPOINT=http://localhost:9000
NEXTAI_MINIO_ACCESS_KEY=nextai-minio
NEXTAI_MINIO_SECRET_KEY=replace-with-a-long-local-secret
NEXTAI_MINIO_BUCKET=nextai-documents
# Semantic cache applies only to context-free document questions. Similarity must be in [0, 1].
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_MINIMUM_SIMILARITY=0.92
SEMANTIC_CACHE_TTL_HOURS=24
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Development only. Production must obtain owner identity from authenticated JWT/session claims.
DEMO_OWNER_ID=local-demo-user
